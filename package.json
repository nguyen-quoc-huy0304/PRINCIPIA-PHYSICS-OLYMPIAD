{
  "name": "principia-physics-olympiad-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "PRINCIPIA Physics Olympiad desktop app with a hybrid embedded browser",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --publish never",
    "build:physics": "tsc -p tsconfig.physics.json"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "vn.principia.physicsolympiad",
    "productName": "PRO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "PRINCIPIA-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "nguyen-quoc-huy0304",
      "repo": "PRINCIPIA-PHYSICS-OLYMPIAD.ghithub.io"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "PRINCIPIA-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "PRINCIPIA-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
