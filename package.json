{
  "name": "principia",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite --host 0.0.0.0",
    "build:wasm": "wasm-pack build crates/physics-core --target bundler --out-dir ../../src/wasm/pkg --out-name physics_core --release",
    "build": "npm run build:wasm && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "tauri": "tauri",
    "tauri:android:init": "tauri android init",
    "tauri:android:build": "tauri android build --apk",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:build": "tauri ios build",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "firebase": "^12.6.0",
    "preact": "^10.27.2",
    "@tauri-apps/api": "^2.9.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@tauri-apps/cli": "^2.9.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-wasm": "^3.4.1"
  }
}
