{
  "name": "principia-physics-olympiad-desktop",
  "version": "1.0.4",
  "private": true,
  "description": "PRINCIPIA Physics Olympiad desktop app with a hybrid embedded browser",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --publish never",
    "test": "node --test tests/js/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "vn.principia.physicsolympiad",
    "productName": "PRO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "desktop/icons/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "PRINCIPIA-Setup.${ext}",
      "extraResources": [
        {
          "from": "rust/target/release/principia-core-server.exe",
          "to": "bin/principia-core-server.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "nguyen-quoc-huy0304",
      "repo": "PRINCIPIA-PHYSICS-OLYMPIAD"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "PRINCIPIA-linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "rust/target/release/principia-core-server",
          "to": "bin/principia-core-server"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "PRINCIPIA-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "rust/target/release/principia-core-server",
          "to": "bin/principia-core-server"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
