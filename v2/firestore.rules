rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPrincipiaAdmin() {
      return signedIn()
        && request.auth.token.email == 'huyquocnguyen03042011@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Published PRINCIPIA content is administrator-managed. Each learner may manage only their own private backup/progress.
    match /principiaUsers/{uid} {
      allow read: if isPrincipiaAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isPrincipiaAdmin() || (signedIn() && request.auth.uid == uid);

      match /legacyData/{documentId} {
        allow read: if isPrincipiaAdmin() || (signedIn() && request.auth.uid == uid);
        allow write: if isPrincipiaAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    match /principiaContent/{document=**} {
      allow read: if signedIn();
      allow write: if isPrincipiaAdmin();
    }

    match /principiaQuestionBanks/{document=**} {
      allow read: if signedIn();
      allow write: if isPrincipiaAdmin();
    }

    match /principiaMedia/{document=**} {
      allow read: if signedIn();
      allow write: if isPrincipiaAdmin();
    }

    match /principiaProgress/{uid} {
      allow read: if isPrincipiaAdmin() || (signedIn() && request.auth.uid == uid);
      // Learners may update only their own private progress document; published content remains admin-only.
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['completed', 'attempts', 'xp', 'streak', 'lastStudyDate', 'updatedAt'])
        && request.resource.data.completed is list
        && request.resource.data.completed.size() <= 5000
        && request.resource.data.attempts is list
        && request.resource.data.attempts.size() <= 100
        && request.resource.data.xp is number
        && request.resource.data.xp >= 0
        && request.resource.data.streak is number
        && request.resource.data.streak >= 0
        && request.resource.data.lastStudyDate is string;
      allow delete: if isPrincipiaAdmin();
    }

    match /principiaLeaderboard/{uid} {
      allow read: if signedIn();
      allow write: if isPrincipiaAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
